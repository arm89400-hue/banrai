PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_y4

JWT_SECRET=change-me

# Days of account access granted per successful payment
ACCOUNT_ACCESS_DAYS=30

# Google OAuth Client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Must match the
# frontend's VITE_GOOGLE_CLIENT_ID exactly - leave blank to disable
# "Login with Google".
GOOGLE_CLIENT_ID=

# Comma-separated emails that get access to the /admin dashboard. They must
# also have a normal account (register/login as usual).
ADMIN_EMAILS=

# Payments: PromptPay QR (amount filled in, can't be changed) + slip check
# by SlipOK (https://slipok.com). Guests pay a 50% deposit online; the other
# half online or at the farm. See backend/src/lib/payments.js.
#
# PROMPTPAY_ID: phone number (10 digits), citizen/tax ID (13) or e-wallet ID
# (15) the money goes to. Empty = guests see a sample QR marked "do not pay".
# It must belong to the bank account registered on the SlipOK branch, or every
# slip is rejected as "wrong account".
PROMPTPAY_ID=
# The account name shown under the QR, as the guest's bank app shows it.
PROMPTPAY_NAME=
# Both empty = slips wait for the owner to check them in admin.
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# Only changed by the payment test (points it at a pretend SlipOK).
SLIPOK_API_URL=
# Shows the "PassPay" test button that marks a payment as paid without real
# money. Keep true until a real transfer has been tested, then set false.
PAYMENT_TEST_MODE=true
