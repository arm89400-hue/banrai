PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_y4

JWT_SECRET=change-me

# Payment provider (okslip) - placeholder until real credentials are available
OKSLIP_API_KEY=
OKSLIP_API_URL=
OKSLIP_WEBHOOK_SECRET=

# Shows the "PassPay" test button that marks a booking's deposit as paid
# without real money. On unless set to false - set false before going live.
PAYMENT_TEST_MODE=true

# Days of account access granted per successful payment
ACCOUNT_ACCESS_DAYS=30

# Google OAuth Client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Must match the
# frontend's VITE_GOOGLE_CLIENT_ID exactly - leave blank to disable
# "Login with Google".
GOOGLE_CLIENT_ID=

# Comma-separated emails that get access to the /admin dashboard. They must
# also have a normal account (register/login as usual).
ADMIN_EMAILS=
