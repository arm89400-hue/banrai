# Settings for docker-compose.yml. Copy to .env (never commit .env).
# On the server, deploy/make-env.sh writes this file for you with a random password.

# Database
DB_PASSWORD=change-me
DB_NAME=baanrai

# Ports on 127.0.0.1 (the host nginx forwards the domain to them)
APP_PORT=8344
API_PORT=8345

# Images (the deploy job pins these to the exact build it just made)
APP_IMAGE=ghcr.io/arm89400-hue/banrai-backend:latest
MIGRATOR_IMAGE=ghcr.io/arm89400-hue/banrai-migrator:latest
WEB_IMAGE=ghcr.io/arm89400-hue/banrai-frontend:latest

# Local builds only: Google sign-in button (public client ID, not a secret)
GOOGLE_CLIENT_ID=
