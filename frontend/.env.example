# Backend API base URL. Defaults to http://localhost:4000 if unset.
VITE_API_URL=http://localhost:4000

# Google OAuth Client ID (Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID > Web application). Must match the
# backend's GOOGLE_CLIENT_ID exactly - leave blank to hide the
# "Login with Google" button.
VITE_GOOGLE_CLIENT_ID=
